# Environment Variables
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/golgappe

# GitHub OAuth (Get these from GitHub App settings)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Session Secret
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Blockchain mode (recommended localnet for development)
BLOCKCHAIN_ENABLED=false
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=
BOUNTY_BOARD_ADDRESS=
CHAIN_ID=31337
CHAIN_NAME=hardhat-local

# Optional hardcoded payout override for local demos
# If FORCE_PAYOUT_WALLET=true, claim payout recipient is always derived from PAYOUT_WALLET_ADDRESS or PAYOUT_WALLET_PRIVATE_KEY
FORCE_PAYOUT_WALLET=false
PAYOUT_WALLET_ADDRESS=
PAYOUT_WALLET_PRIVATE_KEY=

# Optional localnet autofund for the backend signer when a transaction is short on gas/value
AUTOFUND_SIGNER=false
FAUCET_PRIVATE_KEY=